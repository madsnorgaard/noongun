APP_NAME="Noon Gun"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# self_hosted: one workspace, registration closed. saas: not available yet.
NOONGUN_MODE=self_hosted
NOONGUN_AUTO_MIGRATE=true

# Reverse proxies whose X-Forwarded-* headers are trusted, comma separated
# addresses or CIDR ranges. Empty: none. See "Running on a home server" in README.
NOONGUN_TRUSTED_PROXIES=

# Docker Compose settings, read by docker-compose.yml.
NOONGUN_HTTP_PORT=8080
NOONGUN_VITE_PORT=5173
NOONGUN_UID=1000
NOONGUN_GID=1000

# Facebook: the Meta app this instance connects Pages with. See docs/platform-notes/meta.md.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0
# Permissions requested when a Page is connected, comma separated.
# FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
# Base addresses of the Graph API and the login dialog. Change only for testing.
# FACEBOOK_GRAPH_URL=https://graph.facebook.com
# FACEBOOK_DIALOG_URL=https://www.facebook.com

# Publishing. The defaults are shown; see the environment table in the README.
# NOONGUN_PUBLISH_MAX_ATTEMPTS=5
# NOONGUN_PUBLISH_BACKOFF=60,300,900,3600
# NOONGUN_PUBLISH_TIMEOUT=30
# NOONGUN_PUBLISH_LOCK_SECONDS=120
# NOONGUN_PUBLISH_STUCK_AFTER_MINUTES=30
# NOONGUN_PUBLISH_QUEUE=default
# NOONGUN_PUBLISH_CALLS_PER_JOB=3
# Must stay above the longest time limit of a job: 2 x NOONGUN_DRAFT_TIMEOUT + 15.
# REDIS_QUEUE_RETRY_AFTER=300

# Drafting. The instance key for the LLM provider; leave empty when every
# workspace brings its own key. See docs/platform-notes/llm.md.
ANTHROPIC_API_KEY=
# The defaults are shown; see the environment table in the README.
# NOONGUN_DRAFT_PROVIDER=anthropic
# NOONGUN_DRAFT_ANTHROPIC_MODEL=claude-opus-5-5
# How much work the model puts into one answer: low, medium, high, xhigh or
# max. Empty leaves it to the default of the model.
# NOONGUN_DRAFT_ANTHROPIC_EFFORT=
# NOONGUN_DRAFT_MAX_TOKENS=16000
# NOONGUN_DRAFT_TIMEOUT=120
# NOONGUN_DRAFT_PROMPT_VERSION=v1
# Prices per million tokens for the cost estimate, added to the table in
# config/noongun.php. JSON on one line.
# NOONGUN_DRAFT_PRICES={"anthropic":{"claude-opus-5-5":{"input":4,"output":20}}}
# NOONGUN_DRAFT_PRICE_CURRENCY=USD
# What "Propose a week" may spend, and how its job retries.
# NOONGUN_DRAFT_MAX_POSTS_PER_PROPOSAL=14
# NOONGUN_DRAFT_MAX_RUNS_PER_DAY=50
# NOONGUN_DRAFT_MAX_ATTEMPTS=3
# NOONGUN_DRAFT_BACKOFF=30,120
# NOONGUN_DRAFT_STUCK_AFTER_MINUTES=15
# NOONGUN_DRAFT_ESTIMATE_INPUT_TOKENS=8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=noongun
DB_USERNAME=noongun
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noongun@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
