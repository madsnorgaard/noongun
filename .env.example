APP_NAME="Noon Gun"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# self_hosted: one workspace, registration closed. saas: not available yet.
NOONGUN_MODE=self_hosted
NOONGUN_AUTO_MIGRATE=true

# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto headers are
# trusted, comma separated addresses or CIDR ranges. Empty: none. The host is
# always taken from the Host header and must match APP_URL outside the local
# environment. See "Running on a home server" in README.
NOONGUN_TRUSTED_PROXIES=

# Who may open the Horizon dashboard at /horizon: email addresses, comma separated.
# Empty: the owners of the first workspace (self_hosted), nobody (saas).
NOONGUN_OPERATOR_EMAILS=

# Docker Compose settings, read by docker-compose.yml.
# Where the web app is published on the host, as address:port. A bare port
# (8080) is published on every network interface of the host.
NOONGUN_HTTP_PORT=127.0.0.1:8080
NOONGUN_VITE_PORT=5173
NOONGUN_UID=1000
NOONGUN_GID=1000

# Facebook: the Meta app this instance connects Pages with. See docs/platform-notes/meta.md.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0
# Permissions requested when a Page is connected, comma separated. Add
# read_insights to also read the reach and clicks of posts (see "Insights").
# FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
# Base addresses of the Graph API and the login dialog. Change only for testing.
# FACEBOOK_GRAPH_URL=https://graph.facebook.com
# FACEBOOK_DIALOG_URL=https://www.facebook.com

# LinkedIn: the LinkedIn app this instance connects profiles with. See
# "Connecting a LinkedIn profile" in the README.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Sent as the Linkedin-Version header, YYYYMM. LinkedIn stops accepting a
# version about a year after it came out.
LINKEDIN_API_VERSION=202611
# Permissions requested when a profile is connected, comma separated.
# LINKEDIN_SCOPES=openid,profile,w_member_social
# Base addresses of the API and of linkedin.com. Change only for testing.
# LINKEDIN_API_URL=https://api.linkedin.com
# LINKEDIN_WEB_URL=https://www.linkedin.com

# Publishing. The defaults are shown; see the environment table in the README.
# NOONGUN_PUBLISH_MAX_ATTEMPTS=5
# NOONGUN_PUBLISH_BACKOFF=60,300,900,3600
# NOONGUN_PUBLISH_TIMEOUT=30
# NOONGUN_PUBLISH_LOCK_SECONDS=120
# NOONGUN_PUBLISH_STUCK_AFTER_MINUTES=30
# NOONGUN_PUBLISH_QUEUE=default
# NOONGUN_PUBLISH_CALLS_PER_JOB=3
# Must stay above the longest time limit of a job: 2 x NOONGUN_DRAFT_TIMEOUT + 15.
# REDIS_QUEUE_RETRY_AFTER=300

# Insights: reading the numbers of published posts. The defaults are shown;
# see "Insights" and the environment table in the README. The cadence is
# hours:minutes pairs: until a post is that many hours old, read it every that
# many minutes; after the last pair it is not read any more.
# NOONGUN_INSIGHTS_ENABLED=true
# NOONGUN_INSIGHTS_CADENCE=24:60,504:1440
# NOONGUN_INSIGHTS_VARIANTS_PER_RUN=25
# NOONGUN_INSIGHTS_RATE_LIMIT_PERCENT=20
# NOONGUN_INSIGHTS_PAUSE_MINUTES=60
# NOONGUN_INSIGHTS_TIMEOUT=45
# NOONGUN_INSIGHTS_QUEUE=insights
# NOONGUN_INSIGHTS_WEIGHT_REACTIONS=1
# NOONGUN_INSIGHTS_WEIGHT_COMMENTS=2
# NOONGUN_INSIGHTS_WEIGHT_SHARES=3
# NOONGUN_INSIGHTS_WEIGHT_CLICKS=1

# Drafting. The instance keys for the LLM providers, one for each; leave
# them empty when every workspace brings its own key. A key is only used
# with its own provider. See docs/platform-notes/llm.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The defaults are shown; see the environment table in the README.
# NOONGUN_DRAFT_PROVIDER=anthropic
# The providers an owner of a workspace may choose from, comma separated,
# for example anthropic,openai. Empty by default: only the default provider
# above is offered. Listing a provider means the briefs of workspaces that
# choose it are sent to that company.
# NOONGUN_DRAFT_PROVIDERS=
# NOONGUN_DRAFT_ANTHROPIC_MODEL=claude-opus-5-5
# How much work the model puts into one answer: low, medium, high, xhigh or
# max. Empty leaves it to the default of the model.
# NOONGUN_DRAFT_ANTHROPIC_EFFORT=
# NOONGUN_DRAFT_OPENAI_MODEL=gpt-6.2-sol
# Reasoning effort for OpenAI: minimal, low, medium, high, xhigh or max, as
# far as the model accepts it. Empty leaves it to the default of the model.
# NOONGUN_DRAFT_OPENAI_EFFORT=
# NOONGUN_DRAFT_MAX_TOKENS=16000
# NOONGUN_DRAFT_TIMEOUT=120
# NOONGUN_DRAFT_PROMPT_VERSION=v3
# Prices per million tokens for the cost estimate, added to the table in
# config/noongun.php. JSON on one line.
# NOONGUN_DRAFT_PRICES={"anthropic":{"claude-opus-5-5":{"input":4,"output":20}}}
# NOONGUN_DRAFT_PRICE_CURRENCY=USD
# Texts the workspace approved, sent with a draft request as examples: how
# many for each target channel (0 sends none, at most 10), and the most
# characters all examples of one request hold together.
# NOONGUN_DRAFT_EXAMPLES=5
# NOONGUN_DRAFT_EXAMPLES_MAX_CHARS=6000
# Of those, the share in percent that goes to the posts that did best instead
# of the most recent (0 takes only the most recent), and how many days back a
# post may have been published to be taken for how it did.
# NOONGUN_DRAFT_EXAMPLES_TOP_SHARE=50
# NOONGUN_DRAFT_EXAMPLES_TOP_DAYS=90
# What "Propose a week" may spend, and how its job retries.
# NOONGUN_DRAFT_MAX_POSTS_PER_PROPOSAL=14
# NOONGUN_DRAFT_MAX_RUNS_PER_DAY=50
# All workspaces together, on the instance key above.
# NOONGUN_DRAFT_MAX_INSTANCE_RUNS_PER_DAY=200
# NOONGUN_DRAFT_MAX_ATTEMPTS=3
# NOONGUN_DRAFT_BACKOFF=30,120
# NOONGUN_DRAFT_STUCK_AFTER_MINUTES=6
# Slot times closer than this get no draft.
# NOONGUN_DRAFT_LEAD_MINUTES=60
# Size of a usual answer, for the expected cost shown before a proposal.
# NOONGUN_DRAFT_EXPECTED_OUTPUT_TOKENS=1500

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=noongun
DB_USERNAME=noongun
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noongun@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
