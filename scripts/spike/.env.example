# Copy to .env (gitignored) and fill in. Never commit .env or .state/.

# Graph API version to call. Check the changelog before running:
# https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_VERSION=v27.0

# App Dashboard > App settings > Basic
META_APP_ID=
META_APP_SECRET=

# The numeric ID of the Facebook Page to post to (Page > About > Page transparency,
# or leave empty and pick it from the list that 02-page-token.sh prints).
META_PAGE_ID=

# Short-lived user token from Graph API Explorer with the Page permissions granted.
# Used once by 01-long-lived-user-token.sh, then it can be deleted from this file.
META_SHORT_USER_TOKEN=

# Public image URL for the photo post (JPEG or PNG, reachable without login).
SPIKE_PHOTO_URL=

# A local JPEG or PNG for 07-upload-photo-post.sh, which uploads the file itself.
SPIKE_PHOTO_FILE=
