# Copy to .env (gitignored) and fill in. Never commit .env.

# Value of the Linkedin-Version header, YYYYMM. Check the current version first:
# https://learn.microsoft.com/en-us/linkedin/marketing/versioning
LINKEDIN_API_VERSION=202611

# A member access token with the scopes openid, profile and w_member_social.
# The Developer Portal makes one under Docs and tools > OAuth Token Tools.
# Remove it from this file when the spike is done.
LINKEDIN_ACCESS_TOKEN=

# Optional. With both set, the script also asks LinkedIn what it knows about
# the token (status, scopes, expiry) through token introspection.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional. Path of a local JPG or PNG to upload as the thumbnail of the link
# post. Leave empty to post the link card without an image.
SPIKE_THUMBNAIL=
