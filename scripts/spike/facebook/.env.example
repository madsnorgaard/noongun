# Copy to .env (gitignored) and fill in. Never commit .env.

# Graph API version to call. Use the one in FACEBOOK_GRAPH_VERSION.
META_GRAPH_VERSION=v27.0

# App Dashboard > App settings > Basic. Used for appsecret_proof only.
META_APP_SECRET=

# A Page access token of the Page that owns the post. For reach and clicks
# it must have been granted read_insights. ../02-page-token.sh makes one
# and keeps it in ../.state/page_token. Remove it from this file when the
# spike is done.
META_PAGE_TOKEN=

# Optional. What is asked, when it should differ from what the application
# asks by default (config/noongun.php, channels.facebook.metrics).
# SPIKE_POST_FIELDS=
# SPIKE_INSIGHT_METRICS=post_clicks,post_total_media_view_unique
# SPIKE_INSIGHT_PERIOD=lifetime
